{
  "expo": {
    "name": "Naer",
    "slug": "naer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "naer",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naer.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#272c5e",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.naer.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#fb6b5b",
          "iosDisplayInForeground": true,
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
